{
  "name": "pocket-mechanic",
  "version": "1.0.0",
  "description": "Pocket Mechanic: The Clockwork Repair Shop — a touch-first repair-puzzle game for children aged 4–10",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-assets.mjs",
    "playthrough": "node scripts/playthrough.mjs",
    "playthrough:touch": "node scripts/touch-playthrough.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
