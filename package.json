{
  "name": "pocket-mechanic",
  "version": "1.0.0",
  "description": "Pocket Mechanic: The Clockwork Repair Shop \u2014 a touch-first repair-puzzle game for children aged 4\u201310",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --outDir docs/play --emptyOutDir",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-assets.mjs",
    "assets:audio": "node scripts/generate-elevenlabs.mjs",
    "audition": "node scripts/elevenlabs-audition.mjs",
    "audition:serve": "node scripts/elevenlabs-audition.mjs --serve --lan",
    "playthrough": "node scripts/playthrough.mjs",
    "playthrough:touch": "node scripts/touch-playthrough.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:puzzles": "node scripts/visual-puzzle-sweep.mjs --all",
    "check:visuals": "node scripts/sweep-visual-capture.mjs",
    "check:menus": "node scripts/sweep-hub-checks.mjs",
    "check:accessories": "node scripts/check-accessories.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "audition:player": "node scripts/build-audition-player.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
